# Copy to .env for local development. Never commit .env.
# Only the "Required" values are needed to run the app. Every other feature
# switches itself off, or reports that it is not configured, until you set its keys.

# --- Required -----------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/massimino"
NEXTAUTH_URL="http://localhost:3000"
# Generate your own: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Email and password sign-in only works with "jwt". Leave this as it is.
AUTH_SESSION_STRATEGY="jwt"

# --- App URLs -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
BASE_URL=""
NEXT_PUBLIC_BIO_BASE_URL=""

# --- Roles and profiles -------------------------------------------------------
# Comma-separated addresses promoted to ADMIN when they sign in.
ADMIN_EMAILS=""
# Optional vanity usernames for trainer pages, as JSON: {"janedoe":"jane@example.com"}
TRAINER_ALIASES=""

# --- Sign-in providers --------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
NEXT_PUBLIC_FACEBOOK_APP_ID=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# --- AI (Massichat, workout suggestions, content moderation) ------------------
OPENAI_API_KEY=""
OPENAI_ORG_ID=""
OPENAI_PROJECT=""
MISTRAL_API_KEY=""
MISTRAL_MODEL=""

# --- Email --------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM=""
EMAIL_REPLY_TO=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME=""

# --- File storage (Supabase) --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Exercise data and media --------------------------------------------------
PEXELS_API_KEY=""
EXERCISEDB_BASE_URL=""
EXERCISE_MEDIA_SYSTEM_USER_ID=""
NEXT_PUBLIC_EXERCISES_CURATED_ENABLED=""

# --- Payments -----------------------------------------------------------------
MOLLIE_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_WEBHOOK_SECRET=""

# --- Firebase (optional exercise sync) ----------------------------------------
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# --- Scheduled jobs -----------------------------------------------------------
# /api/cron/purge-deleted-accounts answers 503 until this is set.
CRON_SECRET=""

# --- Moderation tuning --------------------------------------------------------
MODERATION_ENABLED=""
MODERATION_STRICT_MODE=""
MODERATION_AUTO_BLOCK=""
MODERATION_LOGGING=""
MODERATION_THRESHOLD=""
REAL_TIME_MODERATION=""
WARNING_THRESHOLD=""
SUSPENSION_THRESHOLD=""
BAN_THRESHOLD=""
REPUTATION_PENALTY=""

# --- Database tuning, logging and monitoring ----------------------------------
DB_CONNECTION_LIMIT=""
DB_CONNECTION_TIMEOUT=""
DB_STATEMENT_TIMEOUT=""
LOG_LEVEL=""
LOG_RETENTION_DAYS=""
SENTRY_DSN=""
